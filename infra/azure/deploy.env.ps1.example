# Copy to deploy.env.ps1, fill in real values, then:
#   . .\infra\azure\deploy.env.ps1
#   .\infra\azure\deploy.ps1
# Do not commit deploy.env.ps1 - it will hold real secrets once filled in.

$env:RESOURCE_GROUP = "rg-opencalendar-prod"
$env:LOCATION = "eastus"
$env:ACR_NAME = "ocacrprod01"                # must be globally unique, alphanumeric only
$env:ENV_NAME = "opencalendar-env"
$env:LOG_ANALYTICS_NAME = "opencalendar-logs"
$env:PG_SERVER_NAME = "opencalendar-pg-prod" # must be globally unique
$env:PG_ADMIN_USER = "ocadmin"
$env:PG_ADMIN_PASSWORD = "change-me-to-a-strong-password"
$env:PG_DB_NAME = "opencalendar"
$env:APP_DOMAIN = "calendar.example.com"     # no scheme, no trailing slash
$env:AFD_PROFILE_NAME = "opencalendar-fd"
$env:AFD_ENDPOINT_NAME = "opencalendar"

# Optional - leave blank to skip
$env:RESEND_API_KEY = ""
$env:MICROSOFT_CLIENT_ID = ""
$env:MICROSOFT_CLIENT_SECRET = ""

# Optional - generated automatically if left unset
# $env:JWT_SECRET = ""
# $env:METRICS_TOKEN = ""
