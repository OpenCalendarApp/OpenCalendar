# Copy to deploy.env, fill in real values, then:
#   source infra/azure/deploy.env
#   bash infra/azure/deploy.sh
# Do not commit deploy.env - it will end up holding real secrets in your shell history/exports.

export RESOURCE_GROUP=rg-opencalendar-prod
export LOCATION=eastus
export ACR_NAME=ocacrprod01                # must be globally unique, alphanumeric only
export ENV_NAME=opencalendar-env
export LOG_ANALYTICS_NAME=opencalendar-logs
export PG_SERVER_NAME=opencalendar-pg-prod # must be globally unique
export PG_ADMIN_USER=ocadmin
export PG_ADMIN_PASSWORD='change-me-to-a-strong-password'
export PG_DB_NAME=opencalendar
export APP_DOMAIN=calendar.example.com     # no scheme, no trailing slash
export AFD_PROFILE_NAME=opencalendar-fd
export AFD_ENDPOINT_NAME=opencalendar

# Optional - leave blank to skip
export RESEND_API_KEY=
export MICROSOFT_CLIENT_ID=
export MICROSOFT_CLIENT_SECRET=

# Optional - generated automatically with openssl if left unset
# export JWT_SECRET=
# export METRICS_TOKEN=
